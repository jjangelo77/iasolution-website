<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IA Solution | Global AI Solutions</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root { --primary: #00d4ff; --accent: #7000ff; --dark: #050608; --card: #111218; }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        
        body { 
            background: var(--dark); color: white; font-family: 'Inter', sans-serif; 
            margin: 0; line-height: 1.6; overflow-x: hidden; text-align: center;
        }

        p, div, h1, h3, span { -webkit-user-select: none; -moz-user-select: none; user-select: none; }

        .lang-selector {
            padding: 20px; display: flex; justify-content: center; gap: 15px;
            background: rgba(255,255,255,0.03); backdrop-filter: blur(10px);
            position: sticky; top: 0; z-index: 100;
        }
        .lang-btn {
            background: none; border: 1px solid #333; color: #888; padding: 5px 12px;
            border-radius: 20px; cursor: pointer; font-size: 0.8rem; transition: 0.3s;
            -webkit-appearance: none; touch-action: manipulation;
        }
        .lang-btn.active { border-color: var(--primary); color: var(--primary); background: rgba(0,212,255,0.1); }

        .hero {
            padding: 80px 20px;
            background: radial-gradient(circle at center, rgba(0, 212, 255, 0.08), transparent);
            display: flex; flex-direction: column; align-items: center; text-align: center;
        }

        h1 { 
            font-size: clamp(2.5rem, 10vw, 4rem); 
            background: linear-gradient(to right, #fff, var(--primary));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-clip: text;
            margin: 10px 0; font-weight: 700; letter-spacing: -2px;
        }

        p.subtitle { 
            font-size: 1.1rem; color: #a0a0a0; max-width: 550px; 
            margin: 20px auto 40px; padding: 0 15px; text-align: center;
        }

        .cta-button { 
            display: flex; justify-content: center; align-items: center;
            width: 100%; max-width: 320px; margin: 0 auto;
            padding: 20px; background: linear-gradient(45deg, var(--primary), var(--accent));
            color: white; text-decoration: none; border-radius: 14px;
            font-weight: bold; font-size: 1.1rem; box-shadow: 0 10px 30px rgba(0, 212, 255, 0.15);
            transition: opacity 0.3s; border: none; cursor: pointer;
            touch-action: manipulation; -webkit-appearance: none;
        }
        .cta-button:hover { opacity: 0.85; }
        .cta-button:active { opacity: 0.7; }

        .services { padding: 40px 20px; max-width: 1100px; margin: auto; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }

        .card { 
            background: var(--card); padding: 40px 30px; border-radius: 24px; 
            border: 1px solid rgba(255,255,255,0.05); text-align: center;
            transition: border-color 0.3s;
        }
        .card:hover { border-color: rgba(0,212,255,0.2); }
        .card h3 { color: var(--primary); margin-bottom: 15px; }
        .card p { color: #888; font-size: 0.95rem; }

        .projects { padding: 20px 20px 60px; max-width: 800px; margin: auto; }

        .section-label {
            text-transform: uppercase; letter-spacing: 4px; color: var(--primary);
            font-size: 0.7rem; font-weight: bold; margin-bottom: 8px;
        }
        .section-sublabel {
            font-size: 0.75rem; color: #555; margin-bottom: 28px;
            font-style: italic;
        }

        .project-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 12px;
        }

        .project-card {
            display: flex; align-items: center; gap: 16px;
            background: var(--card); border: 1px solid rgba(255,255,255,0.05);
            border-radius: 16px; padding: 18px 20px;
            text-align: left;
        }

        .project-icon {
            width: 42px; height: 42px; border-radius: 12px;
            background: rgba(0,212,255,0.08); border: 1px solid rgba(0,212,255,0.12);
            display: grid; place-items: center; font-size: 18px; flex-shrink: 0;
        }
        .project-body { flex: 1; min-width: 0; }
        .project-name { font-size: 14px; font-weight: 700; color: white; margin-bottom: 3px; }
        .project-desc { font-size: 12px; color: #666; }
        .project-tag {
            font-size: 10px; color: #555; border: 1px solid #222;
            border-radius: 20px; padding: 3px 10px; white-space: nowrap; flex-shrink: 0;
        }

        footer { padding: 60px 20px; color: #444; font-size: 0.8rem; border-top: 1px solid rgba(255,255,255,0.05); }
    </style>
</head>
<body>

    <nav class="lang-selector">
        <button class="lang-btn active" id="btn-en">EN</button>
        <button class="lang-btn" id="btn-pt">PT</button>
        <button class="lang-btn" id="btn-es">ES</button>
    </nav>

    <section class="hero">
        <div id="top-tag" style="text-transform: uppercase; letter-spacing: 4px; color: var(--primary); font-size: 0.7rem; font-weight: bold;">
            Future is Now
        </div>
        <h1>IA Solution</h1>
        <p id="hero-desc" class="subtitle">We create the future of your company with high-performance artificial intelligence and automation.</p>
        <a id="cta-text" href="mailto:contato@iasolution.cloud" class="cta-button">Talk to a Specialist</a>
    </section>

    <div class="services">
        <div class="grid">
            <div class="card">
                <h3 id="card1-t">Workflow AI</h3>
                <p id="card1-d">Total integration of systems to eliminate manual and repetitive tasks.</p>
            </div>
            <div class="card">
                <h3 id="card2-t">Custom SaaS</h3>
                <p id="card2-d">Development of complete platforms with native AI power.</p>
            </div>
            <div class="card">
                <h3 id="card3-t">Telegram Agents</h3>
                <p id="card3-d">Conversational AI agents for sales and support via Telegram API.</p>
            </div>
        </div>
    </div>

    <section class="projects">
        <button class="cta-button" id="proj-toggle-btn" style="margin: 0 auto;">
            🚀 <span id="proj-btn-label">Our Projects</span>
        </button>

        <div id="proj-wrapper" style="display:none; margin-top: 32px;">
            <p id="proj-label" class="section-label">Practical Projects</p>
            <p id="proj-sublabel" class="section-sublabel">Some real examples of what we build</p>
            <div class="project-grid">

                <div class="project-card">
                    <div class="project-icon">🥗</div>
                    <div class="project-body">
                        <div class="project-name">FitPlano</div>
                        <div id="p1-desc" class="project-desc">AI nutrition platform — personalized PDF plans and evolution dashboard</div>
                    </div>
                    <span class="project-tag">SaaS</span>
                </div>

                <div class="project-card">
                    <div class="project-icon">🖥️</div>
                    <div class="project-body">
                        <div class="project-name">Totem OrderPay</div>
                        <div id="p2-desc" class="project-desc">Premium self-service kiosk for restaurants — PWA + hardware + local support</div>
                    </div>
                    <span class="project-tag">SaaS B2B</span>
                </div>

                <div class="project-card">
                    <div class="project-icon">💧</div>
                    <div class="project-body">
                        <div class="project-name">Hydro</div>
                        <div id="p3-desc" class="project-desc">Daily hydration tracking PWA with cloud sync</div>
                    </div>
                    <span class="project-tag">PWA</span>
                </div>

                <div class="project-card">
                    <div class="project-icon">🤖</div>
                    <div class="project-body">
                        <div class="project-name">Ailym</div>
                        <div id="p4-desc" class="project-desc">AI sales agent on Telegram — conversational flow and automated support</div>
                    </div>
                    <span class="project-tag">Bot</span>
                </div>

                <div class="project-card">
                    <div class="project-icon">✝️</div>
                    <div class="project-body">
                        <div class="project-name">Bom Dia com Deus Pai</div>
                        <div id="p5-desc" class="project-desc">Biblical counselor for emotional support, spiritual reflections and real-time spiritual guidance, directly on your WhatsApp</div>
                    </div>
                    <span class="project-tag">Bot</span>
                </div>

            </div>
        </div>
    </section>

    <div style="padding: 0 20px 60px; display: flex; justify-content: center;">
        <a id="cta-text-2" href="mailto:contato@iasolution.cloud" class="cta-button">Talk to a Specialist</a>
    </div>

    <footer>
        <p>&copy; 2026 IA SOLUTION CLOUD<br>
        <span id="footer-text">Automation Technology and Artificial Intelligence</span><br>
        <a href="mailto:contato@iasolution.cloud" style="color: #555; text-decoration: none;">contato@iasolution.cloud</a></p>
    </footer>

    <script>
        let currentLang = 'en';

        const translations = {
            en: {
                tag: "Future is Now",
                heroDesc: "We create the future of your company with high-performance artificial intelligence and automation.",
                cta: "Talk to a Specialist",
                c1t: "Workflow AI",      c1d: "Total integration of systems to eliminate manual and repetitive tasks.",
                c2t: "Custom SaaS",     c2d: "Development of complete platforms with native AI power.",
                c3t: "Telegram Agents", c3d: "Conversational AI agents for sales and support via Telegram API.",
                projLabel: "Practical Projects",
                projSub: "Some real examples of what we build",
                projBtn: "Some of Our Projects",
                projBtnClose: "Hide Projects",
                p1: "AI nutrition platform — personalized PDF plans and evolution dashboard",
                p2: "Premium self-service kiosk for restaurants — PWA + hardware + local support",
                p3: "Daily hydration tracking PWA with cloud sync",
                p4: "AI sales agent on Telegram — conversational flow and automated support",
                p5: "Biblical counselor for emotional support, spiritual reflections and real-time spiritual guidance, directly on your WhatsApp",
                foot: "Automation Technology and Artificial Intelligence"
            },
            pt: {
                tag: "O Futuro é Agora",
                heroDesc: "Criamos o futuro da sua empresa com inteligência artificial e automação de alta performance.",
                cta: "Falar com Especialista",
                c1t: "Fluxos de Automação", c1d: "Integração total de sistemas para eliminar tarefas manuais e repetitivas.",
                c2t: "SaaS Custom",         c2d: "Desenvolvimento de plataformas completas com IA nativa.",
                c3t: "Agentes Telegram",    c3d: "Agentes conversacionais com IA para vendas e suporte via Telegram.",
                projLabel: "Projetos Práticos",
                projSub: "Alguns exemplos reais do que construímos",
                projBtn: "Alguns dos Nossos Projetos",
                projBtnClose: "Fechar Projetos",
                p1: "Plataforma de nutrição com IA — planos em PDF e dashboard de evolução",
                p2: "Totem premium de autoatendimento para restaurantes — PWA + hardware + suporte local",
                p3: "PWA de hidratação diária com sincronização em nuvem",
                p4: "Agente de vendas com IA no Telegram — fluxo conversacional automatizado",
                p5: "Conselheira à luz da bíblia para acolhimento emocional, reflexões bíblicas e suporte espiritual em tempo real, direto no seu WhatsApp",
                foot: "Tecnologia em Automação e Inteligência Artificial"
            },
            es: {
                tag: "El Futuro es Ahora",
                heroDesc: "Creamos el futuro de su empresa con inteligencia artificial y automatización de alto rendimiento.",
                cta: "Hablar con Especialista",
                c1t: "Flujos de Automatización", c1d: "Integración total de sistemas para eliminar tareas manuales y repetitivas.",
                c2t: "SaaS Custom",              c2d: "Desarrollo de plataformas completas con IA nativa.",
                c3t: "Agentes Telegram",         c3d: "Agentes conversacionales con IA para ventas y soporte vía Telegram.",
                projLabel: "Proyectos Prácticos",
                projSub: "Algunos ejemplos reales de lo que construimos",
                projBtn: "Algunos de Nuestros Proyectos",
                projBtnClose: "Cerrar Proyectos",
                p1: "Plataforma de nutrición con IA — planes en PDF y dashboard de evolución",
                p2: "Kiosk premium de autoatención para restaurantes — PWA + hardware + soporte local",
                p3: "PWA de hidratación diaria con sincronización en la nube",
                p4: "Agente de ventas con IA en Telegram — flujo conversacional automatizado",
                p5: "Consejera a la luz de la biblia para acogimiento emocional, reflexiones bíblicas y apoyo espiritual en tiempo real, directo en su WhatsApp",
                foot: "Tecnología en Automatización e Inteligencia Artificial"
            }
        };

        function setLang(lang) {
            currentLang = lang;
            const t = translations[lang];
            document.getElementById('top-tag').innerText        = t.tag;
            document.getElementById('hero-desc').innerText      = t.heroDesc;
            document.getElementById('cta-text').innerText       = t.cta;
            document.getElementById('cta-text-2').innerText     = t.cta;
            document.getElementById('card1-t').innerText        = t.c1t;
            document.getElementById('card1-d').innerText        = t.c1d;
            document.getElementById('card2-t').innerText        = t.c2t;
            document.getElementById('card2-d').innerText        = t.c2d;
            document.getElementById('card3-t').innerText        = t.c3t;
            document.getElementById('card3-d').innerText        = t.c3d;
            document.getElementById('proj-label').innerText     = t.projLabel;
            document.getElementById('proj-sublabel').innerText  = t.projSub;
            document.getElementById('proj-btn-label').innerText = t.projBtn;
            document.getElementById('p1-desc').innerText        = t.p1;
            document.getElementById('p2-desc').innerText        = t.p2;
            document.getElementById('p3-desc').innerText        = t.p3;
            document.getElementById('p4-desc').innerText        = t.p4;
            document.getElementById('p5-desc').innerText        = t.p5;
            document.getElementById('footer-text').innerText    = t.foot;
            document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById('btn-' + lang).classList.add('active');
        }

        function toggleProjects() {
            const wrapper = document.getElementById('proj-wrapper');
            const isOpen = wrapper.style.display === 'block';
            wrapper.style.display = isOpen ? 'none' : 'block';
            document.getElementById('proj-btn-label').innerText = isOpen
                ? translations[currentLang].projBtn
                : translations[currentLang].projBtnClose;
        }

        // Eventos via addEventListener para funcionar no mobile
        document.getElementById('btn-en').addEventListener('click', function() { setLang('en'); });
        document.getElementById('btn-pt').addEventListener('click', function() { setLang('pt'); });
        document.getElementById('btn-es').addEventListener('click', function() { setLang('es'); });
        document.getElementById('proj-toggle-btn').addEventListener('click', function() { toggleProjects(); });

        document.addEventListener('contextmenu', e => e.preventDefault());
        document.addEventListener('dragstart', e => e.preventDefault());
    </script>
</body>
</html>
